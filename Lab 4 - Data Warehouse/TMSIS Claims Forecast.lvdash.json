{
  "datasets": [
    {
      "name": "be3bb181",
      "displayName": "TMSIS Claims",
      "queryLines": [
        "select\n",
        "  COALESCE(a.DATE, b.DATE) as DATE,\n",
        "  a.PAYMENT_AMOUNT,\n",
        "  b.FORECAST_AMOUNT\n",
        "from (\n",
        "  select DATE_TRUNC('DAY', DSCHRG_DT) as DATE, round(sum(TOT_MDCD_PD_AMT), 0) as PAYMENT_AMOUNT\n",
        "  from scottblack_dev.silver.tmsis_claims tc\n",
        "  where DSCHRG_DT is not null\n",
        "  group by DATE\n",
        ") a\n",
        "full outer join (\n",
        "  select ts.discharge_date as DATE, round(sum(ts.total_amount)) as FORECAST_AMOUNT\n",
        "  from scottblack_dev.gold.tmsis_forecast ts\n",
        "  group by DATE\n",
        ") b\n",
        "on a.DATE = b.DATE"
      ]
    },
    {
      "name": "d8f0fde6",
      "displayName": "Diag By Month",
      "queryLines": [
        "SELECT \n",
        "    DATE_TRUNC('month', SRVC_BGNNG_DT) AS month,\n",
        "    DGNS_CD_1,\n",
        "    COUNT(DGNS_CD_1) AS diagnosis_count\n",
        "FROM \n",
        "    silver.tmsis_claims\n",
        "GROUP BY \n",
        "    DATE_TRUNC('month', SRVC_BGNNG_DT), DGNS_CD_1\n",
        "ORDER BY \n",
        "    month;"
      ],
      "catalog": "scottblack_dev",
      "schema": "default"
    },
    {
      "name": "53201525",
      "displayName": "tmsis_stats",
      "queryLines": [
        "SELECT * \n",
        "FROM scottblack_dev.silver.tmsis_stats"
      ]
    },
    {
      "name": "pi_rules_ds",
      "displayName": "Improper Payment Flags by Rule",
      "queryLines": [
        "SELECT flag_rule, flag_description,\n",
        "       COUNT(*) AS FLAGGED_CLAIMS,\n",
        "       ROUND(SUM(TOT_MDCD_PD_AMT), 0) AS FLAGGED_DOLLARS\n",
        "FROM scottblack_dev.gold.tmsis_improper_payment_flags\n",
        "GROUP BY flag_rule, flag_description\n",
        "ORDER BY FLAGGED_DOLLARS DESC"
      ]
    },
    {
      "name": "ovp_ds",
      "displayName": "Outpatient Overpayments",
      "queryLines": [
        "SELECT PRVDR_ID,\n",
        "       ROUND(SUM(TOT_MDCD_PD_AMT), 0) AS OVERPAID_AMOUNT,\n",
        "       COUNT(*) AS CLAIMS\n",
        "FROM scottblack_dev.gold.tmsis_improper_payment_flags\n",
        "WHERE flag_rule = 'OUTPATIENT_OVERPAYMENT'\n",
        "GROUP BY PRVDR_ID\n",
        "ORDER BY OVERPAID_AMOUNT DESC"
      ]
    },
    {
      "name": "pi_risk_ds",
      "displayName": "Providers to Investigate First",
      "queryLines": [
        "SELECT PRVDR_ID, flagged_claims, distinct_rules, flagged_dollars\n",
        "FROM scottblack_dev.gold.tmsis_provider_risk_summary\n",
        "ORDER BY flagged_dollars DESC\n",
        "LIMIT 25"
      ]
    }
  ],
