   "source": [
    "-- Replace {catalog} with the name of your catalog\n",
    "\n",
    "select DATE_TRUNC('DAY',DSCHRG_DT) DATE, round(sum(TOT_MDCD_PD_AMT), 0) as PAYMENT_AMOUNT, COUNT(*) as NUM_CLAIMS\n",
    "from {catalog}.silver.tmsis_claims\n",
    "where DSCHRG_DT is not null\n",
    "group by DATE\n",
    "order by DATE"
   ]
  }
